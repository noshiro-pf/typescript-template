{
  // https://www.typescriptlang.org/ja/tsconfig
  "compilerOptions": {
    // Type Checking
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    // "alwaysStrict": true,                 // enabled by "strict"
    // "strictBindCallApply": true,          // enabled by "strict"
    // "strictFunctionTypes": true,          // enabled by "strict"
    // "strictNullChecks": true,             // enabled by "strict"
    // "strictPropertyInitialization": true, // enabled by "strict"
    // "noImplicitAny": true,                // enabled by "strict"
    // "noImplicitThis": true,               // enabled by "strict"
    // "useUnknownInCatchVariables": true,   // enabled by "strict"

    "noEmit": true,

    // Modules
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,

    // Language and Environment
    "target": "ESNext",

    // JavaScript Support
    "allowJs": true,
    "checkJs": true,

    // Interop Constraints
    // Note: "allowSyntheticDefaultImports": false was removed because
    // disabling it is deprecated in TypeScript 6.0 (TS5107) and will stop
    // functioning in 7.0 ("esModuleInterop": true implies it anyway).
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,

    "erasableSyntaxOnly": false,
    "verbatimModuleSyntax": false,

    // Don't include @types/* by default
    "types": [],

    "lib": ["ESNext", "DOM"],

    // The strict standard library, in place of TypeScript's own declarations.
    // TypeScript 7 defaults `libReplacement` to false, so the `paths` entry
    // below does nothing without it.
    "libReplacement": true,

    // Every built-in library lives inside the one `strict-ts-lib-v7.0`
    // package, so this wildcard is what points `libReplacement` at it.
    // `paths` is replaced — not merged — by a config that `extends` another,
    // so any config defining `paths` of its own has to repeat this entry;
    // a missing entry disables the replacement with no diagnostic, which is
    // what `test/strict-lib-active.mts` exists to catch.
    "paths": {},

    // Completeness
    "skipLibCheck": true
  }
}
